<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MML" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowBackground">@color/mml_background</item>
        <item name="android:colorBackground">@color/mml_background</item>
        <item name="android:colorAccent">@color/mml_accent</item>
        <item name="android:textColorPrimary">@color/mml_primary</item>
        <item name="android:textColorSecondary">@color/mml_secondary</item>
        <item name="android:textColorLink">@color/mml_link</item>
        <item name="android:navigationBarColor">@color/mml_background</item>
        <item name="android:statusBarColor">@color/mml_background</item>
        <item name="android:navigationBarDividerColor">@color/mml_rule</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:buttonStyle">@style/Widget.MML.Button</item>
        <item name="android:editTextStyle">@style/Widget.MML.EditText</item>
        <item name="android:alertDialogTheme">@style/Theme.MML.Dialog</item>
    </style>

    <style name="Widget.MML.Button" parent="android:style/Widget.Material.Button">
        <item name="android:textColor">@color/mml_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:backgroundTint">@color/mml_surface</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:singleLine">false</item>
    </style>

    <style name="Widget.MML.EditText" parent="android:style/Widget.Material.EditText">
        <item name="android:textColor">@color/mml_primary</item>
        <item name="android:textColorHint">@color/mml_secondary</item>
        <item name="android:backgroundTint">@color/mml_accent</item>
        <item name="android:padding">8dp</item>
    </style>

    <style name="Theme.MML.Dialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/mml_surface</item>
        <item name="android:colorBackground">@color/mml_surface</item>
        <item name="android:textColorPrimary">@color/mml_primary</item>
        <item name="android:textColorSecondary">@color/mml_secondary</item>
        <item name="android:textColorLink">@color/mml_link</item>
        <item name="android:colorAccent">@color/mml_accent</item>
    </style>
</resources>
